  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Fill_DIM_Czas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{401a14fc-265b-4245-a23f-56fa1266d631}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Fill_DIM_Czas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6559574C-C822-476A-9535-AF66EF6E643E}"
          SQLTask:SqlStatementSource="DELETE FROM dbo.DIM_Czas;&#xA;DBCC CHECKIDENT ('DWH_SEWIK_METEO.dbo.DIM_Czas', RESEED, 0);&#xA;&#xA;INSERT INTO dbo.DIM_Czas (godzina, czy_godzina_szczytu, pora_dnia, pora_dnia_nr, czy_noc, godzina_etykieta)&#xA;SELECT &#xA;    g AS godzina,&#xA;    CASE WHEN g IN (7,8,15,16,17) THEN 'T' ELSE 'N' END,&#xA;    CASE WHEN g BETWEEN 6 AND 11 THEN 'Rano'&#xA;         WHEN g BETWEEN 12 AND 16 THEN 'Południe'&#xA;         WHEN g BETWEEN 17 AND 21 THEN 'Wieczór'&#xA;         ELSE 'Noc' END,&#xA;    CASE WHEN g BETWEEN 6 AND 11 THEN 1&#xA;         WHEN g BETWEEN 12 AND 16 THEN 2&#xA;         WHEN g BETWEEN 17 AND 21 THEN 3&#xA;         ELSE 4 END,&#xA;    CASE WHEN g BETWEEN 6 AND 21 THEN 'N' ELSE 'T' END,&#xA;    RIGHT('0'+CAST(g AS VARCHAR(2)),2) + ':00'&#xA;FROM (SELECT number AS g FROM master..spt_values WHERE type='P' AND number BETWEEN 0 AND 23) x;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Fill_DIM_Data"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0b1af024-fd8e-4905-bb27-d32e9bf70563}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Fill_DIM_Data"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6559574C-C822-476A-9535-AF66EF6E643E}"
          SQLTask:SqlStatementSource="INSERT INTO DWH_SEWIK_METEO.dbo.DIM_Data (&#xA;    data, dzien, miesiac, rok, kwartal, kwartal_nr,&#xA;    miesiac_nr, dzien_tygodnia, dzien_tygodnia_nr,&#xA;    czy_weekend, tydzien_w_roku, rok_miesiac,&#xA;    czy_swieto, swieto_nazwa&#xA;)&#xA;SELECT DISTINCT&#xA;    TRY_CAST(data_zdarz AS DATE),&#xA;    CAST(DAY(TRY_CAST(data_zdarz AS DATE)) AS NVARCHAR),&#xA;    DATENAME(MONTH, TRY_CAST(data_zdarz AS DATE)),&#xA;    CAST(YEAR(TRY_CAST(data_zdarz AS DATE)) AS NVARCHAR),&#xA;    CASE &#xA;        WHEN MONTH(TRY_CAST(data_zdarz AS DATE)) IN (1,2,3) THEN 'Q1'&#xA;        WHEN MONTH(TRY_CAST(data_zdarz AS DATE)) IN (4,5,6) THEN 'Q2'&#xA;        WHEN MONTH(TRY_CAST(data_zdarz AS DATE)) IN (7,8,9) THEN 'Q3'&#xA;        ELSE 'Q4'&#xA;    END,&#xA;    CASE &#xA;        WHEN MONTH(TRY_CAST(data_zdarz AS DATE)) IN (1,2,3) THEN 1&#xA;        WHEN MONTH(TRY_CAST(data_zdarz AS DATE)) IN (4,5,6) THEN 2&#xA;        WHEN MONTH(TRY_CAST(data_zdarz AS DATE)) IN (7,8,9) THEN 3&#xA;        ELSE 4&#xA;    END,&#xA;    MONTH(TRY_CAST(data_zdarz AS DATE)),&#xA;    DATENAME(WEEKDAY, TRY_CAST(data_zdarz AS DATE)),&#xA;    DATEPART(WEEKDAY, TRY_CAST(data_zdarz AS DATE)),&#xA;    CASE &#xA;        WHEN DATEPART(WEEKDAY, TRY_CAST(data_zdarz AS DATE)) IN (1,7) THEN 1 &#xA;        ELSE 0 &#xA;    END,&#xA;    DATEPART(WEEK, TRY_CAST(data_zdarz AS DATE)),&#xA;    CAST(YEAR(TRY_CAST(data_zdarz AS DATE)) AS NVARCHAR) + '-' + &#xA;        RIGHT('0' + CAST(MONTH(TRY_CAST(data_zdarz AS DATE)) AS NVARCHAR), 2),&#xA;    'N',&#xA;    'BRAK'&#xA;FROM DWH_SEWIK_METEO.dbo.STG_Zdarzenie&#xA;WHERE data_zdarz IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
