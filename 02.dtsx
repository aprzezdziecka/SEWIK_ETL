    <DTS:Executable
      DTS:refId="Package\Fill_FAKT_Zdarzenie"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{c73cb49f-edba-437d-8b92-906cdb7964f1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Fill_FAKT_Zdarzenie"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6559574C-C822-476A-9535-AF66EF6E643E}"
          SQLTask:SqlStatementSource="-- ================================================================&#xA;-- POPRAWIONE I ZOPTYMALIZOWANE ZASILANIE FAKT_Zdarzenie&#xA;-- (Wykonuje się w kilka sekund zamiast w nieskończoność)&#xA;-- ================================================================&#xA;&#xA;INSERT INTO dbo.FAKT_Zdarzenie (&#xA;    nr_karty_wypadku,&#xA;    data_godzina,&#xA;    data_zgloszenia,&#xA;    data_przyjazdu,&#xA;    czas_dojazdu_min,&#xA;    id_lokalizacja,&#xA;    id_jednostki,&#xA;    id_droga_info,&#xA;    id_data,&#xA;    id_czas&#xA;)&#xA;SELECT&#xA;    s.nr_karty_wypadku,&#xA;    TRY_CAST(s.data_zdarzenia AS DATETIME),&#xA;    ISNULL(TRY_CAST(s.data_zgloszenia AS DATETIME), '1900-01-01'),&#xA;    ISNULL(TRY_CAST(s.data_przyjazdu AS DATETIME), '1900-01-01'),&#xA;    CASE &#xA;        WHEN s.data_zgloszenia IS NOT NULL AND s.data_przyjazdu IS NOT NULL&#xA;        THEN DATEDIFF(MINUTE, TRY_CAST(s.data_zgloszenia AS DATETIME), TRY_CAST(s.data_przyjazdu AS DATETIME))&#xA;        ELSE 0&#xA;    END,&#xA;    -- 1. Id Lokalizacji&#xA;    l.id_lokalizacja,&#xA;    -- 2. Id Jednostki&#xA;    j.id_jednostki,&#xA;    -- 3. Id Drogi (Złączenie po PEŁNYM kluczu biznesowym, aby uniknąć iloczynu kartezjańskiego)&#xA;    d.id_droga_info,&#xA;    -- 4. Id Daty&#xA;    dt.id_data,&#xA;    -- 5. Id Czasu&#xA;    c.id_czas&#xA;FROM dbo.STG_Zdarzenie s&#xA;-- Łączenie z DIM_Lokalizacja (dokładny klucz)&#xA;LEFT JOIN dbo.DIM_Lokalizacja l &#xA;    ON l.kod_terytorialny_gus = ISNULL(s.kod_gus, 'BRAK')&#xA;   AND l.ulica = ISNULL(s.ulica_adres, 'BRAK')&#xA;   AND l.numer_domu = ISNULL(s.numer_domu, 'BRAK')&#xA;   AND l.miejscowość = ISNULL(s.miejscowosc, 'BRAK')&#xA;&#xA;-- Łączenie z DIM_Jednostki&#xA;LEFT JOIN dbo.DIM_Jednostki j &#xA;    ON j.jednostka_terytorialna = ISNULL(s.jednostka_miejsca, 'BRAK')&#xA;   AND j.jednostka_obslugujaca = ISNULL(s.jednostka_likwidujaca, 'BRAK')&#xA;   AND j.jednostka_operatora = ISNULL(s.jednostka_operatora, 'BRAK')&#xA;&#xA;-- Łączenie z DIM_Droga_Info (Musisz wymienić wszystkie kolumny użyte w SELECT DISTINCT tego wymiaru!)&#xA;LEFT JOIN dbo.DIM_Droga_Info d &#xA;    ON  ISNULL(d.rodzaj_zdarzenia_kod, '')   = ISNULL(s.rodzaj_zdarzenia_kod, '')&#xA;    AND ISNULL(d.nawierzchnia_kod, '')       = ISNULL(s.nawierzchnia_kod, '')&#xA;    AND ISNULL(d.stan_nawierzchni_kod, '')   = ISNULL(s.stan_nawierzchni_kod, '')&#xA;    AND ISNULL(d.oznakowanie_poziome, '')    = ISNULL(s.oznakowanie_poz_kod, '')&#xA;    AND ISNULL(d.geometria_drogi_kod, '')    = ISNULL(s.geometria_drogi_kod, '')&#xA;    AND ISNULL(d.charakter_miejsca_kod, '')  = ISNULL(s.charakt_miejsca_kod, '')&#xA;    AND ISNULL(d.obszar_zabudowany_kod, '')  = ISNULL(s.obszar_zabudowany_kod, '')&#xA;    AND ISNULL(d.oswietlenie_kod, '')        = ISNULL(s.oswietlenie_kod, '')&#xA;    AND ISNULL(d.typ_skrzyzowania_kod, '')   = ISNULL(s.typ_skrzyzowania_kod, '')&#xA;    AND ISNULL(d.typ_drogi_kod, '')          = ISNULL(s.zssd_kod, '')&#xA;    AND ISNULL(d.predkosc_dopuszczalna, 0)   = ISNULL(TRY_CAST(s.predkosc_dopuszczalna AS SMALLINT), 0)&#xA;    AND ISNULL(d.liczba_pasow, 0)            = ISNULL(TRY_CAST(s.liczba_pasow AS SMALLINT), 0)&#xA;&#xA;-- Łączenie z DIM_Data&#xA;LEFT JOIN dbo.DIM_Data dt &#xA;    ON dt.data = TRY_CAST(s.data_zdarz AS DATE)&#xA;&#xA;-- Łączenie z DIM_Czas&#xA;LEFT JOIN dbo.DIM_Czas c &#xA;    ON c.godzina_etykieta = s.godzina_zdarz&#xA;WHERE s.nr_karty_wypadku IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
