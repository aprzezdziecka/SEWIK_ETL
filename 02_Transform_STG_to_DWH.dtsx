  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Fill_DIM_Czas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{EF2E7BB5-A086-461B-AA4E-C44988970584}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Fill_DIM_Czas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{FAC51824-8A58-464B-956C-CBB60D4AB00E}"
          SQLTask:SqlStatementSource="INSERT INTO DIM_Czas (&#xA;    godzina, czy_godzina_szczytu, pora_dnia, pora_dnia_nr,&#xA;    czy_noc, godzina_etykieta&#xA;)&#xA;SELECT DISTINCT&#xA;    CAST(LEFT(godzina_zdarz, 2) AS SMALLINT),&#xA;    CASE &#xA;        WHEN CAST(LEFT(godzina_zdarz, 2) AS INT) IN (7,8,15,16,17) THEN 'T' &#xA;        ELSE 'N' &#xA;    END,&#xA;    CASE &#xA;        WHEN CAST(LEFT(godzina_zdarz, 2) AS INT) BETWEEN 6  AND 11 THEN 'Rano'&#xA;        WHEN CAST(LEFT(godzina_zdarz, 2) AS INT) BETWEEN 12 AND 16 THEN 'Południe'&#xA;        WHEN CAST(LEFT(godzina_zdarz, 2) AS INT) BETWEEN 17 AND 21 THEN 'Wieczór'&#xA;        ELSE 'Noc'&#xA;    END,&#xA;    CASE &#xA;        WHEN CAST(LEFT(godzina_zdarz, 2) AS INT) BETWEEN 6  AND 11 THEN 1&#xA;        WHEN CAST(LEFT(godzina_zdarz, 2) AS INT) BETWEEN 12 AND 16 THEN 2&#xA;        WHEN CAST(LEFT(godzina_zdarz, 2) AS INT) BETWEEN 17 AND 21 THEN 3&#xA;        ELSE 4&#xA;    END,&#xA;    CASE &#xA;        WHEN CAST(LEFT(godzina_zdarz, 2) AS INT) BETWEEN 6 AND 21 THEN 'N' &#xA;        ELSE 'T' &#xA;    END,&#xA;    godzina_zdarz&#xA;FROM STG_Zdarzenie&#xA;WHERE godzina_zdarz IS NOT NULL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Fill_DIM_Data"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F0AF2E93-E8E0-409B-93C4-21B3CB1B7861}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Fill_DIM_Data"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{FAC51824-8A58-464B-956C-CBB60D4AB00E}"
          SQLTask:SqlStatementSource="INSERT INTO DIM_Data (&#xA;    data, dzien, miesiac, rok, kwartal, kwartal_nr,&#xA;    miesiac_nr, dzien_tygodnia, dzien_tygodnia_nr,&#xA;    czy_weekend, tydzien_w_roku, rok_miesiac,&#xA;    czy_swieto, święto_nazwa&#xA;)&#xA;SELECT DISTINCT&#xA;    TRY_CAST(data_zdarz AS DATE),&#xA;    CAST(DAY(TRY_CAST(data_zdarz AS DATE)) AS NVARCHAR),&#xA;    DATENAME(MONTH, TRY_CAST(data_zdarz AS DATE)),&#xA;    CAST(YEAR(TRY_CAST(data_zdarz AS DATE)) AS NVARCHAR),&#xA;    CASE &#xA;        WHEN MONTH(TRY_CAST(data_zdarz AS DATE)) IN (1,2,3) THEN 'Q1'&#xA;        WHEN MONTH(TRY_CAST(data_zdarz AS DATE)) IN (4,5,6) THEN 'Q2'&#xA;        WHEN MONTH(TRY_CAST(data_zdarz AS DATE)) IN (7,8,9) THEN 'Q3'&#xA;        ELSE 'Q4'&#xA;    END,&#xA;    CASE &#xA;        WHEN MONTH(TRY_CAST(data_zdarz AS DATE)) IN (1,2,3) THEN 1&#xA;        WHEN MONTH(TRY_CAST(data_zdarz AS DATE)) IN (4,5,6) THEN 2&#xA;        WHEN MONTH(TRY_CAST(data_zdarz AS DATE)) IN (7,8,9) THEN 3&#xA;        ELSE 4&#xA;    END,&#xA;    MONTH(TRY_CAST(data_zdarz AS DATE)),&#xA;    DATENAME(WEEKDAY, TRY_CAST(data_zdarz AS DATE)),&#xA;    DATEPART(WEEKDAY, TRY_CAST(data_zdarz AS DATE)),&#xA;    CASE &#xA;        WHEN DATEPART(WEEKDAY, TRY_CAST(data_zdarz AS DATE)) IN (1,7) THEN 1 &#xA;        ELSE 0 &#xA;    END,&#xA;    DATEPART(WEEK, TRY_CAST(data_zdarz AS DATE)),&#xA;    CAST(YEAR(TRY_CAST(data_zdarz AS DATE)) AS NVARCHAR) + '-' + &#xA;        RIGHT('0' + CAST(MONTH(TRY_CAST(data_zdarz AS DATE)) AS NVARCHAR), 2),&#xA;    'N',&#xA;    'BRAK'&#xA;FROM STG_Zdarzenie&#xA;WHERE data_zdarz IS NOT NULL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Fill_DIM_Droga_Info"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4672C5E3-A58B-4D3F-B81B-F0717166A45F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Fill_DIM_Droga_Info"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{FAC51824-8A58-464B-956C-CBB60D4AB00E}"
          SQLTask:SqlStatementSource="INSERT INTO DIM_Droga_Info (&#xA;    predkosc_dopuszczalna, liczba_pasow, odleglosc_skrzyzowania,&#xA;    nawierzchnia_kod, stan_nawierzchni_kod, oznakowanie_poziome,&#xA;    geometria_drogi_kod, charakter_miejsca_kod, obszar_zabudowany_kod,&#xA;    oswietlenie_kod, rodzaj_zdarzenia_kod, typ_skrzyzowania_kod,&#xA;    strefa_zamieszkania, strefa_ruchu, typ_drogi_kod&#xA;)&#xA;SELECT DISTINCT&#xA;    TRY_CAST(predkosc_dopuszczalna AS SMALLINT),&#xA;    TRY_CAST(liczba_pasow AS SMALLINT),&#xA;    TRY_CAST(odleglosc_skrzyz AS INT),&#xA;    nawierzchnia_kod,&#xA;    stan_nawierzchni_kod,&#xA;    oznakowanie_poz_kod,&#xA;    geometria_drogi_kod,&#xA;    charakt_miejsca_kod,&#xA;    obszar_zabudowany_kod,&#xA;    oswietlenie_kod,&#xA;    rodzaj_zdarzenia_kod,&#xA;    typ_skrzyzowania_kod,&#xA;    strefa_zamieszkala,&#xA;    strefa_ruchu,&#xA;    zssd_kod&#xA;FROM STG_Zdarzenie&#xA;WHERE rodzaj_zdarzenia_kod IS NOT NULL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Fill_DIM_Jednostki"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5B9A654D-39D9-4130-B46E-535C944919CC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Fill_DIM_Jednostki"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{FAC51824-8A58-464B-956C-CBB60D4AB00E}"
          SQLTask:SqlStatementSource="INSERT INTO DIM_Jednostki (&#xA;    jednostka_terytorialna,&#xA;    jednostka_obslugujaca,&#xA;    jednostka_operatora&#xA;)&#xA;SELECT DISTINCT&#xA;    jednostka_miejsca,&#xA;    jednostka_likwidujaca,&#xA;    jednostka_operatora&#xA;FROM STG_Zdarzenie&#xA;WHERE jednostka_miejsca IS NOT NULL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Fill_DIM_Lokalizacja"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{049D824B-DD25-43EF-93D7-04675E5C3C6D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Fill_DIM_Lokalizacja"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{FAC51824-8A58-464B-956C-CBB60D4AB00E}"
          SQLTask:SqlStatementSource="INSERT INTO DIM_Lokalizacja (&#xA;    kod_terytorialny_gus, ulica, numer_domu, powiat, gmina,&#xA;    miejscowość, wojewodztwo, ulica_skrzyzowania,&#xA;    gps_szerokość, gps_długość, id_siatka&#xA;)&#xA;SELECT DISTINCT&#xA;    ISNULL(kod_gus, 'BRAK'),&#xA;    ISNULL(ulica_adres, 'BRAK'),&#xA;    ISNULL(numer_domu, 'BRAK'),&#xA;    ISNULL(powiat, 'BRAK'),&#xA;    ISNULL(gmina, 'BRAK'),&#xA;    ISNULL(miejscowosc, 'BRAK'),&#xA;    ISNULL(woj, 'BRAK'),&#xA;    ISNULL(ulica_skrzyz, 'BRAK'),&#xA;    ISNULL(TRY_CAST(REPLACE(gps_y_gus, ',', '.') AS DECIMAL(10,7)), 0),&#xA;    ISNULL(TRY_CAST(REPLACE(gps_x_gus, ',', '.') AS DECIMAL(10,7)), 0),&#xA;    0&#xA;FROM STG_Zdarzenie&#xA;WHERE kod_gus IS NOT NULL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Fill_FAKT_Zdarzenie"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{80AC97DE-61B9-41F0-ADC8-22CA6DA50FDA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Fill_FAKT_Zdarzenie"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{FAC51824-8A58-464B-956C-CBB60D4AB00E}"
          SQLTask:SqlStatementSource="-- ================================================================&#xA;-- POPRAWIONE I ZOPTYMALIZOWANE ZASILANIE FAKT_Zdarzenie&#xA;-- (Wykonuje się w kilka sekund zamiast w nieskończoność)&#xA;-- ================================================================&#xA;&#xA;INSERT INTO dbo.FAKT_Zdarzenie (&#xA;    nr_karty_wypadku,&#xA;    data_godzina,&#xA;    data_zgloszenia,&#xA;    data_przyjazdu,&#xA;    czas_dojazdu_min,&#xA;    id_lokalizacja,&#xA;    id_jednostki,&#xA;    id_droga_info,&#xA;    id_data,&#xA;    id_czas&#xA;)&#xA;SELECT&#xA;    s.nr_karty_wypadku,&#xA;    TRY_CAST(s.data_zdarzenia AS DATETIME),&#xA;    ISNULL(TRY_CAST(s.data_zgloszenia AS DATETIME), '1900-01-01'),&#xA;    ISNULL(TRY_CAST(s.data_przyjazdu AS DATETIME), '1900-01-01'),&#xA;    CASE &#xA;        WHEN s.data_zgloszenia IS NOT NULL AND s.data_przyjazdu IS NOT NULL&#xA;        THEN DATEDIFF(MINUTE, TRY_CAST(s.data_zgloszenia AS DATETIME), TRY_CAST(s.data_przyjazdu AS DATETIME))&#xA;        ELSE 0&#xA;    END,&#xA;    -- 1. Id Lokalizacji&#xA;    l.id_lokalizacja,&#xA;    -- 2. Id Jednostki&#xA;    j.id_jednostki,&#xA;    -- 3. Id Drogi (Złączenie po PEŁNYM kluczu biznesowym, aby uniknąć iloczynu kartezjańskiego)&#xA;    d.id_droga_info,&#xA;    -- 4. Id Daty&#xA;    dt.id_data,&#xA;    -- 5. Id Czasu&#xA;    c.id_czas&#xA;FROM dbo.STG_Zdarzenie s&#xA;-- Łączenie z DIM_Lokalizacja (dokładny klucz)&#xA;LEFT JOIN dbo.DIM_Lokalizacja l &#xA;    ON l.kod_terytorialny_gus = ISNULL(s.kod_gus, 'BRAK')&#xA;   AND l.ulica = ISNULL(s.ulica_adres, 'BRAK')&#xA;   AND l.numer_domu = ISNULL(s.numer_domu, 'BRAK')&#xA;   AND l.miejscowość = ISNULL(s.miejscowosc, 'BRAK')&#xA;&#xA;-- Łączenie z DIM_Jednostki&#xA;LEFT JOIN dbo.DIM_Jednostki j &#xA;    ON j.jednostka_terytorialna = ISNULL(s.jednostka_miejsca, 'BRAK')&#xA;   AND j.jednostka_obslugujaca = ISNULL(s.jednostka_likwidujaca, 'BRAK')&#xA;   AND j.jednostka_operatora = ISNULL(s.jednostka_operatora, 'BRAK')&#xA;&#xA;-- Łączenie z DIM_Droga_Info (Musisz wymienić wszystkie kolumny użyte w SELECT DISTINCT tego wymiaru!)&#xA;LEFT JOIN dbo.DIM_Droga_Info d &#xA;    ON  ISNULL(d.rodzaj_zdarzenia_kod, '')   = ISNULL(s.rodzaj_zdarzenia_kod, '')&#xA;    AND ISNULL(d.nawierzchnia_kod, '')       = ISNULL(s.nawierzchnia_kod, '')&#xA;    AND ISNULL(d.stan_nawierzchni_kod, '')   = ISNULL(s.stan_nawierzchni_kod, '')&#xA;    AND ISNULL(d.oznakowanie_poziome, '')    = ISNULL(s.oznakowanie_poz_kod, '')&#xA;    AND ISNULL(d.geometria_drogi_kod, '')    = ISNULL(s.geometria_drogi_kod, '')&#xA;    AND ISNULL(d.charakter_miejsca_kod, '')  = ISNULL(s.charakt_miejsca_kod, '')&#xA;    AND ISNULL(d.obszar_zabudowany_kod, '')  = ISNULL(s.obszar_zabudowany_kod, '')&#xA;    AND ISNULL(d.oswietlenie_kod, '')        = ISNULL(s.oswietlenie_kod, '')&#xA;    AND ISNULL(d.typ_skrzyzowania_kod, '')   = ISNULL(s.typ_skrzyzowania_kod, '')&#xA;    AND ISNULL(d.typ_drogi_kod, '')          = ISNULL(s.zssd_kod, '')&#xA;    AND ISNULL(d.predkosc_dopuszczalna, 0)   = ISNULL(TRY_CAST(s.predkosc_dopuszczalna AS SMALLINT), 0)&#xA;    AND ISNULL(d.liczba_pasow, 0)            = ISNULL(TRY_CAST(s.liczba_pasow AS SMALLINT), 0)&#xA;&#xA;-- Łączenie z DIM_Data&#xA;LEFT JOIN dbo.DIM_Data dt &#xA;    ON dt.data = TRY_CAST(s.data_zdarz AS DATE)&#xA;&#xA;-- Łączenie z DIM_Czas&#xA;LEFT JOIN dbo.DIM_Czas c &#xA;    ON c.godzina_etykieta = s.godzina_zdarz&#xA;WHERE s.nr_karty_wypadku IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
