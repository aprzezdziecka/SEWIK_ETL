      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Foreach Loop Container\Execute SQL Task"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{71FA401B-83C3-4D7A-B733-15D3F8D6817C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Execute SQL Task"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0A18F87A-4048-4EE7-BBE7-063D60506BC4}"
              SQLTask:SqlStatementSource="USE DWH_SEWIK_METEO;&#xA;&#xA;DECLARE @xml XML;&#xA;DECLARE @sciezka NVARCHAR(500) = ?;&#xA;DECLARE @sql NVARCHAR(MAX);&#xA;DECLARE @xmltext NVARCHAR(MAX);&#xA;&#xA;SET @sql = N'SELECT @xmltext = CAST(xml_content AS NVARCHAR(MAX)) &#xA;             FROM OPENROWSET(BULK N''' + @sciezka + N''', SINGLE_CLOB) AS x(xml_content)';&#xA;EXEC sp_executesql @sql, N'@xmltext NVARCHAR(MAX) OUTPUT', @xmltext OUTPUT;&#xA;&#xA;SET @xmltext = SUBSTRING(@xmltext, CHARINDEX('&lt;SEWIK', @xmltext), LEN(@xmltext));&#xA;SET @xml = CAST(@xmltext AS XML);&#xA;&#xA;INSERT INTO DWH_SEWIK_METEO.dbo.STG_Zdarzenie (&#xA;    stg_data_wczytania, stg_plik_zrodlowy,&#xA;    id_zdarzenia, nr_karty_wypadku, kod_gus,&#xA;    jednostka_miejsca, jednostka_likwidujaca, jednostka_operatora,&#xA;    woj, powiat, gmina, miejscowosc,&#xA;    ulica_adres, numer_domu, ulica_skrzyz,&#xA;    km_hm, gps_x_gus, gps_y_gus,&#xA;    data_zdarzenia, data_zdarz, godzina_zdarz,&#xA;    data_zgloszenia, data_przyjazdu,&#xA;    predkosc_dopuszczalna, liczba_pasow, droga_publiczna, odleglosc_skrzyz,&#xA;    nawierzchnia_kod, stan_nawierzchni_kod, rodzaj_drogi_kod,&#xA;    oznakowanie_poz_kod, geometria_drogi_kod, obszar_zabudowany_kod,&#xA;    charakt_miejsca_kod, typ_skrzyzowania_kod,&#xA;    strefa_ruchu,&#xA;    rodzaj_zdarzenia_kod, oswietlenie_kod,&#xA;    warunki_atm_kod, inne_przyczyny_kod, zssd_kod,&#xA;    sygnalizacja_swietlna_kod&#xA;)&#xA;SELECT&#xA;    GETDATE(),&#xA;    @sciezka,&#xA;    z.value('(ID)[1]',                                                          'NVARCHAR(50)'),&#xA;    z.value('(NR_KW)[1]',                                                       'NVARCHAR(100)'),&#xA;    z.value('(KOD_GUS)[1]',                                                     'NVARCHAR(20)'),&#xA;    z.value('(JEDNOSTKA_MIEJSCA)[1]',                                            'NVARCHAR(200)'),&#xA;    z.value('(JEDNOSTKA_LIKWIDUJACA)[1]',                                        'NVARCHAR(200)'),&#xA;    z.value('(JEDNOSTKA_OPERATORA)[1]',                                          'NVARCHAR(200)'),&#xA;    z.value('(WOJ)[1]',                                                          'NVARCHAR(100)'),&#xA;    z.value('(POWIAT)[1]',                                                       'NVARCHAR(100)'),&#xA;    z.value('(GMINA)[1]',                                                        'NVARCHAR(100)'),&#xA;    z.value('(MIEJSCOWOSC)[1]',                                                  'NVARCHAR(200)'),&#xA;    z.value('(ULICA_ADRES)[1]',                                                  'NVARCHAR(200)'),&#xA;    z.value('(NUMER_DOMU)[1]',                                                   'NVARCHAR(50)'),&#xA;    z.value('(ULICA_SKRZYZ)[1]',                                                 'NVARCHAR(200)'),&#xA;    z.value('(KM_HM)[1]',                                                        'NVARCHAR(20)'),&#xA;    z.value('(GPS_X_GUS)[1]',                                                    'NVARCHAR(30)'),&#xA;    z.value('(GPS_Y_GUS)[1]',                                                    'NVARCHAR(30)'),&#xA;    z.value('(DATA_ZDARZENIA)[1]',                                               'NVARCHAR(30)'),&#xA;    z.value('(DATA_ZDARZ)[1]',                                                   'NVARCHAR(20)'),&#xA;    z.value('(GODZINA_ZDARZ)[1]',                                                'NVARCHAR(10)'),&#xA;    z.value('(DATA_ZGLOSZENIA)[1]',                                              'NVARCHAR(30)'),&#xA;    z.value('(DATA_PRZYJAZDU)[1]',                                               'NVARCHAR(30)'),&#xA;    z.value('(PREDKOSC_DOPUSZCZALNA)[1]',                                        'NVARCHAR(10)'),&#xA;    z.value('(LICZBA_PASOW)[1]',                                                 'NVARCHAR(10)'),&#xA;    z.value('(DROGA_PUBLICZNA)[1]',                                              'NVARCHAR(5)'),&#xA;    z.value('(ODLEGLOSC_SKRZYZ)[1]',                                             'NVARCHAR(20)'),&#xA;    z.value('(INFO_O_DRODZE/NAWIERZCHNIA/NADR_KOD/NADR_KOD)[1]',               'NVARCHAR(10)'),&#xA;    z.value('(INFO_O_DRODZE/STAN_NAWIERZCHNI/STNA_KOD/STNA_KOD)[1]',           'NVARCHAR(10)'),&#xA;    z.value('(INFO_O_DRODZE/RODZAJ_DROGI/RODR_KOD_CONTAINER/RODR_KOD)[1]',     'NVARCHAR(10)'),&#xA;    z.value('(INFO_O_DRODZE/OZNAKOWANIE_POZIOME/OZPO_KOD/OZPO_KOD)[1]',        'NVARCHAR(10)'),&#xA;    z.value('(MIEJSCE/GEOMETRIA_DROGI/GEOD_KOD/GEOD_KOD)[1]',                  'NVARCHAR(10)'),&#xA;    z.value('(MIEJSCE/OBSZAR_ZABUDOWANY/ZABU_KOD/ZABU_KOD)[1]',                'NVARCHAR(10)'),&#xA;    z.value('(MIEJSCE/CHARAKT_MIEJSCA/CHMZ_KOD/CHMZ_KOD)[1]',                  'NVARCHAR(10)'),&#xA;    z.value('(MIEJSCE/SKRZYZOWANIE/SKRZ_KOD_CONTAINER/SKRZ_KOD)[1]',           'NVARCHAR(10)'),&#xA;    z.value('(STREFA_RUCHU)[1]',                                                 'NVARCHAR(10)'),&#xA;    z.value('(SZRD_KOD)[1]',                                                     'NVARCHAR(10)'),&#xA;    z.value('(SZOS_KOD)[1]',                                                     'NVARCHAR(10)'),&#xA;    z.value('(WARUNKI_ATMOSFERYCZNE/SSWA_KOD/SSWA_KOD)[1]',                    'NVARCHAR(10)'),&#xA;    z.value('(INNE_PRZYCZYNY/SPIP_KOD/SPIP_KOD)[1]',                           'NVARCHAR(10)'),&#xA;    z.value('(ZSSD_KOD)[1]',                                                     'NVARCHAR(100)'),&#xA;    z.value('(INFO_O_DRODZE/SYGNALIZACJA_SWIETLNA/SYSW_KOD/SYSW_KOD)[1]',     'NVARCHAR(10)')&#xA;FROM @xml.nodes('/SEWIK_EXP_XML_02/ZDARZENIA/ZDARZENIE') AS x(z);&#xA;&#xA;INSERT INTO DWH_SEWIK_METEO.dbo.STG_Pojazd (&#xA;    stg_data_wczytania, stg_plik_zrodlowy,&#xA;    id_pojazdu, id_zdarzenia, nr_pojazdu, rodzaj_pojazdu,&#xA;    marka, rok_produkcji, stan_pojazdu_kod, wyposazenie_dod, data_ost_bad_tech&#xA;)&#xA;SELECT&#xA;    GETDATE(),&#xA;    @sciezka,&#xA;    p.value('(ID)[1]',                'NVARCHAR(50)'),&#xA;    p.value('(ZSZD_ID)[1]',           'NVARCHAR(50)'),&#xA;    p.value('(NR_POJAZDU)[1]',        'NVARCHAR(10)'),&#xA;    p.value('(RODZAJ_POJAZDU)[1]',    'NVARCHAR(20)'),&#xA;    p.value('(MARKA)[1]',             'NVARCHAR(100)'),&#xA;    p.value('(ROK_PRODUKCJI)[1]',     'NVARCHAR(10)'),&#xA;    p.value('(SPSU_KOD)[1]',          'NVARCHAR(20)'),&#xA;    p.value('(WYPOSAZENIE_DOD)[1]',   'NVARCHAR(200)'),&#xA;    p.value('(DATA_OST_BAD_TECH)[1]', 'NVARCHAR(20)')&#xA;FROM @xml.nodes('/SEWIK_EXP_XML_02/ZDARZENIA/ZDARZENIE/POJAZDY/POJAZD') AS x(p);&#xA;&#xA;INSERT INTO DWH_SEWIK_METEO.dbo.STG_Osoba (&#xA;    stg_data_wczytania, stg_plik_zrodlowy,&#xA;    id_osoby, id_zdarzenia, id_pojazdu,&#xA;    rola_uczestnika_kod, data_urodzenia, plec,&#xA;    obcokrajowiec_kod, stan_uczestnika_kod, miejsce_w_poj_kod,&#xA;    odblaski, inwalida, zbiegl_z_miejsca,&#xA;    liczba_lat_kier, poziom_alkoholu, pod_wplywem_kod,&#xA;    stopien_obrazen_kod, przyczyna_kier_kod, przyczyna_piesz_kod,&#xA;    jazda_bez_upr_kod, rozstrzygniecie_kod&#xA;)&#xA;SELECT&#xA;    GETDATE(),&#xA;    @sciezka,&#xA;    o.value('(ID)[1]',                    'NVARCHAR(50)'),&#xA;    o.value('(ZSZD_ID)[1]',               'NVARCHAR(50)'),&#xA;    o.value('(ZSPO_ID)[1]',               'NVARCHAR(50)'),&#xA;    o.value('(SSRU_KOD)[1]',              'NVARCHAR(20)'),&#xA;    o.value('(DATA_UR)[1]',               'NVARCHAR(20)'),&#xA;    o.value('(PLEC)[1]',                  'NVARCHAR(5)'),&#xA;    o.value('(SOBY_KOD)[1]',              'NVARCHAR(20)'),&#xA;    o.value('(SUSU_KOD)[1]',              'NVARCHAR(20)'),&#xA;    o.value('(MIEJSCE_W_POJ_KOD)[1]',     'NVARCHAR(20)'),&#xA;    o.value('(ODBLASKI)[1]',              'NVARCHAR(5)'),&#xA;    o.value('(INWALIDA)[1]',              'NVARCHAR(5)'),&#xA;    o.value('(ZBIEGL_Z_MIEJSCA)[1]',      'NVARCHAR(5)'),&#xA;    o.value('(LICZBA_LAT_KIEROWANIA)[1]', 'NVARCHAR(10)'),&#xA;    o.value('(POZIOM_ALKOHOLU)[1]',       'NVARCHAR(20)'),&#xA;    o.value('(POD_WPLYWEM_KOD)[1]',       'NVARCHAR(20)'),&#xA;    o.value('(STOPIEN_OBRAZEN_KOD)[1]',   'NVARCHAR(20)'),&#xA;    o.value('(PRZYCZYNA_KIER_KOD)[1]',    'NVARCHAR(20)'),&#xA;    o.value('(PRZYCZYNA_PIESZ_KOD)[1]',   'NVARCHAR(20)'),&#xA;    o.value('(JAZDA_BEZ_UPR_KOD)[1]',     'NVARCHAR(20)'),&#xA;    o.value('(ROZSTRZYGNIECIE_KOD)[1]',   'NVARCHAR(20)')&#xA;FROM @xml.nodes('/SEWIK_EXP_XML_02/ZDARZENIA/ZDARZENIE/UCZESTNICY/OSOBA') AS x(o);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::XmlFilePath"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="130"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
